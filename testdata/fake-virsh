#!/bin/sh
set -eu

readonly=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --readonly) readonly=1; shift ;;
    --connect) shift 2 ;;
    --connect=*) shift ;;
    *) break ;;
  esac
done

cmd=${1:-}
[ "$#" -gt 0 ] && shift

case "$cmd" in
  version)
    printf 'Compiled against library: libvirt 10.0.0\nUsing library: libvirt 10.0.0\nRunning hypervisor: QEMU 8.2.0\n'
    ;;
  nodeinfo)
    printf 'CPU model:           x86_64\nCPU(s):              8\nCore(s) per socket:  4\nSocket(s):           1\nThread(s) per core:  2\nNUMA cell(s):        1\nMemory size:         16777216 KiB\n'
    ;;
  nodecpustats)
    printf 'usage:           12.5%%\nuser:            1000000000\nsystem:          500000000\nidle:            6000000000\niowait:          0\n'
    ;;
  nodememstats)
    printf 'total:           16777216\nfree:            8388608\nbuffers:         1048576\ncached:          2097152\navailable:       11534336\n'
    ;;
  domstats)
    printf "Domain: 'web-prod'\n  state.state=1\n  state.reason=1\n  cpu.time=180000000000\n  balloon.current=2097152\n  balloon.maximum=4194304\n  vcpu.current=4\n  vcpu.maximum=4\n\nDomain: 'db-staging'\n  state.state=5\n  state.reason=1\n  balloon.maximum=4194304\n  vcpu.maximum=4\n"
    ;;
  list)
    case " $* " in
      *" --name "*) printf 'web-prod\ndb-staging\n' ;;
      *) printf ' Id   Name          State\n----------------------------\n 7    web-prod      running\n -    db-staging    shut off\n' ;;
    esac
    ;;
  dominfo)
    printf 'Id:             7\nName:           %s\nUUID:           11111111-2222-3333-4444-555555555555\nState:          running\nCPU(s):         4\nMax memory:     4194304 KiB\nUsed memory:    2097152 KiB\nAutostart:      disable\nPersistent:     yes\n' "${1:-vm}"
    ;;
  dumpxml)
    case " $* " in
      *" --security-info "*)
        if [ "$readonly" -eq 0 ]; then
          printf '<domain type="kvm"><name>%s</name><devices><graphics type="vnc" port="5900" autoport="yes" listen="127.0.0.1" passwd="vnc-secret"/></devices></domain>\n' "${2:-vm}"
        else
          printf '<domain type="kvm"><name>%s</name><devices><graphics type="vnc" port="5900" autoport="yes" listen="127.0.0.1"/></devices></domain>\n' "${2:-vm}"
        fi
        ;;
      *) printf '<domain type="kvm"><name>%s</name><devices><graphics type="vnc" port="5900" autoport="yes" listen="127.0.0.1"/></devices></domain>\n' "${1:-vm}" ;;
    esac
    ;;
  domblklist)
    case " $* " in
      *" --details "*) printf ' Type   Device   Target   Source\n------------------------------------------------------------\n file   disk     vda      /var/lib/libvirt/images/vm.qcow2\n' ;;
      *) printf ' Target   Source\n------------------------------\n vda      /var/lib/libvirt/images/vm.qcow2\n' ;;
    esac
    ;;
  domblkinfo)
    printf 'Capacity:       42949672960\nAllocation:     10737418240\nPhysical:       10737418240\n'
    ;;
  domblkerror)
    printf 'No errors found\n'
    ;;
  dommemstat)
    printf 'actual 4294967296\nrss 2147483648\navailable 3221225472\nunused 1073741824\n'
    ;;
  event)
    printf '2026-11-11 00:00:00.000+0000: event 'lifecycle' for domain %s: Started Booted\n' "${1:-vm}"
    ;;
  domiflist)
    printf ' Interface   Type      Source     Model    MAC\n--------------------------------------------------------------\n vnet0       network   default    virtio   52:54:00:00:00:01\n'
    ;;
  backup-list)
    printf ' Name      Creation Time               State\n---------------------------------------------------\n nightly   2026-11-11 00:00:00 +0800  complete\n'
    ;;
  snapshot-list)
    case " $* " in
      *" --name "*) printf 'clean\n' ;;
      *) printf ' Name   Creation Time               State\n---------------------------------------------------\n clean  2026-10-20 10:00:00 +0800  shutoff\n' ;;
    esac
    ;;
  pool-list)
    case " $* " in
      *" --name "*) printf 'default\n' ;;
      *) printf ' Name      State    Autostart   Persistent\n----------------------------------------------\n default   active   yes         yes\n' ;;
    esac
    ;;
  pool-info)
    printf 'Name:           default\nUUID:           11111111-2222-3333-4444-555555555555\nState:          running\nPersistent:     yes\nAutostart:      yes\nCapacity:       100.00 GiB\nAllocation:     20.00 GiB\nAvailable:      80.00 GiB\n'
    ;;
  vol-list)
    printf ' Name          Path\n---------------------------------------------------------\n web.qcow2     /var/lib/libvirt/images/web.qcow2\n'
    ;;
  vol-info)
    printf 'Name:           web.qcow2\nType:           file\nCapacity:       20.00 GiB\nAllocation:     10.00 GiB\n'
    ;;
  net-list)
    case " $* " in
      *" --name "*) printf 'default\n' ;;
      *) printf ' Name      State    Autostart   Persistent\n----------------------------------------------\n default   active   yes         yes\n' ;;
    esac
    ;;
  net-info)
    printf 'Name:           default\nUUID:           11111111-2222-3333-4444-555555555555\nActive:         yes\nPersistent:     yes\nAutostart:      yes\nBridge:         virbr0\n'
    ;;
  start|shutdown|reboot|destroy|suspend|resume|autostart|undefine|snapshot-create-as|snapshot-revert|snapshot-delete|backup-create-as|backup-restore|backup-delete|blockresize|setvcpus|setmem|vol-create-as|vol-clone|vol-resize|vol-delete|pool-refresh|pool-start|pool-autostart|pool-info|net-start|net-destroy|net-autostart|net-info|net-dhcp-leases)
    printf 'Domain operation accepted: %s\n' "$cmd"
    ;;
  slow)
    sleep 30
    printf 'slow operation finished\n'
    ;;
  *)
    printf 'fake virsh does not implement: %s\n' "$cmd" >&2
    exit 1
    ;;
esac

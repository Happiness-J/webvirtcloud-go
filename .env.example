# Copy to .env for Docker Compose, or use these names in systemd.
POSTGRES_DB=wvc
POSTGRES_USER=wvc
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password

# Docker Compose builds this from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB.
# Keep POSTGRES_PASSWORD URL-safe (A-Z a-z 0-9 . _ ~ -). If it contains
# URL-reserved characters, leave this unset and URL-encode the password in an
# explicit WVC_DATABASE_URL override instead.
# WVC_DATABASE_URL=postgres://wvc:replace-with-a-long-random-password@db:5432/wvc?sslmode=disable
WVC_ADDR=:8080
# Docker-only host publish address. Keep 127.0.0.1 behind Nginx. Use
# 0.0.0.0 only for a trusted LAN/VPN without a reverse proxy; direct HTTP has
# no transport encryption.
WVC_PUBLISH_ADDR=127.0.0.1
WVC_ADMIN_USERNAME=admin
# Leave empty to generate a one-time password in a mode-0600 file under the
# master-key directory (for example /app/data/initial-admin-password-*.txt).
# Remove this value from the service environment after the first admin exists.
WVC_ADMIN_PASSWORD=
WVC_MASTER_KEY_FILE=/app/data/master.key

WVC_WORKERS=2
# Queued + running job ceilings. Per-host writes are serialized regardless of
# these limits; read-only jobs remain parallel.
WVC_MAX_ACTIVE_JOBS_PER_USER=20
WVC_MAX_ACTIVE_JOBS=200
WVC_SESSION_TTL=12h
WVC_MAX_SESSIONS_PER_USER=20
WVC_COMMAND_TIMEOUT=15m
WVC_MAX_COMMAND_TIMEOUT=1h
WVC_CONSOLE_TOKEN_TTL=1m
WVC_MAX_CONSOLE_SESSIONS=64
WVC_MAX_OUTPUT_BYTES=1048576
WVC_MAX_ARGS=128
WVC_MAX_STDIN_BYTES=1048576

WVC_SECURE_COOKIES=false
WVC_TRUST_PROXY=false
WVC_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
WVC_LOGIN_WINDOW=15m
WVC_LOGIN_MAX_FAILURES=5
WVC_LOGIN_IP_MAX_FAILURES=25
WVC_LOGIN_GLOBAL_MAX_FAILURES=200
WVC_ARGON2_CONCURRENCY=2

WVC_LOG_LEVEL=info
WVC_LOG_FORMAT=text
WVC_JOB_RETENTION=720h
WVC_AUDIT_RETENTION=4320h
WVC_AUDIT_VERIFY_TIMEOUT=30m
# Leave empty to disable the /metrics endpoint. When set, use a long random
# value and send it as "Authorization: Bearer <token>".
WVC_METRICS_TOKEN=

WVC_VIRSH_BIN=virsh
WVC_QEMU_IMG_BIN=qemu-img
WVC_QEMU_IO_BIN=qemu-io
WVC_QEMU_NBD_BIN=qemu-nbd
WVC_QEMU_STORAGE_DAEMON_BIN=qemu-storage-daemon
WVC_QEMU_PR_HELPER_BIN=qemu-pr-helper
WVC_QEMU_TRACE_STAP_BIN=qemu-trace-stap
WVC_QEMU_VMSR_HELPER_BIN=qemu-vmsr-helper
WVC_QEMU_VNC_BIN=qemu-vnc
# OpenSSH client used by qemu+ssh consoles and remote command execution.
WVC_SSH_BIN=ssh
# Fixed PATH used for QEMU/virt/libguestfs tools executed over qemu+ssh.
# The panel never reuses container-side absolute binary paths on KVM hosts.
WVC_REMOTE_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# virt/libguestfs tools. Missing helpers remain visible in the command center
# with a "missing" badge; set an absolute path when the executable is not on
# the service PATH.
WVC_VIRT_ADMIN_BIN=virt-admin
WVC_VIRT_HOST_VALIDATE_BIN=virt-host-validate
WVC_VIRT_QEMU_RUN_BIN=virt-qemu-run
WVC_VIRT_LOGIN_SHELL_BIN=virt-login-shell
WVC_VIRT_XML_VALIDATE_BIN=virt-xml-validate
WVC_VIRT_PKI_VALIDATE_BIN=virt-pki-validate
WVC_VIRT_SANLOCK_CLEANUP_BIN=virt-sanlock-cleanup
WVC_VIRT_INSTALL_BIN=virt-install
WVC_VIRT_CLONE_BIN=virt-clone
WVC_VIRT_CONVERT_BIN=virt-convert
WVC_VIRT_XML_BIN=virt-xml
WVC_GUESTFISH_BIN=guestfish
WVC_GUESTMOUNT_BIN=guestmount
WVC_GUESTUNMOUNT_BIN=guestunmount
WVC_LIBGUESTFS_TEST_TOOL_BIN=libguestfs-test-tool
WVC_LIBGUESTFS_MAKE_FIXED_APPLIANCE_BIN=libguestfs-make-fixed-appliance
WVC_VIRT_ALIGNMENT_SCAN_BIN=virt-alignment-scan
WVC_VIRT_BUILDER_BIN=virt-builder
WVC_VIRT_BUILDER_REPOSITORY_BIN=virt-builder-repository
WVC_VIRT_CAT_BIN=virt-cat
WVC_VIRT_COPY_IN_BIN=virt-copy-in
WVC_VIRT_COPY_OUT_BIN=virt-copy-out
WVC_VIRT_CUSTOMIZE_BIN=virt-customize
WVC_VIRT_DF_BIN=virt-df
WVC_VIRT_DIB_BIN=virt-dib
WVC_VIRT_DIFF_BIN=virt-diff
WVC_VIRT_EDIT_BIN=virt-edit
WVC_VIRT_FILESYSTEMS_BIN=virt-filesystems
WVC_VIRT_FORMAT_BIN=virt-format
WVC_VIRT_GET_KERNEL_BIN=virt-get-kernel
WVC_VIRT_INSPECTOR_BIN=virt-inspector
WVC_VIRT_LIST_FILESYSTEMS_BIN=virt-list-filesystems
WVC_VIRT_LIST_PARTITIONS_BIN=virt-list-partitions
WVC_VIRT_LOG_BIN=virt-log
WVC_VIRT_LS_BIN=virt-ls
WVC_VIRT_MAKE_FS_BIN=virt-make-fs
WVC_VIRT_P2V_BIN=virt-p2v
WVC_VIRT_P2V_MAKE_DISK_BIN=virt-p2v-make-disk
WVC_VIRT_P2V_MAKE_KICKSTART_BIN=virt-p2v-make-kickstart
WVC_VIRT_RESCUE_BIN=virt-rescue
WVC_VIRT_RESIZE_BIN=virt-resize
WVC_VIRT_SPARSIFY_BIN=virt-sparsify
WVC_VIRT_SYSPREP_BIN=virt-sysprep
WVC_VIRT_TAIL_BIN=virt-tail
WVC_VIRT_TAR_BIN=virt-tar
WVC_VIRT_TAR_IN_BIN=virt-tar-in
WVC_VIRT_TAR_OUT_BIN=virt-tar-out
WVC_VIRT_V2V_BIN=virt-v2v
WVC_VIRT_V2V_IN_PLACE_BIN=virt-v2v-in-place
WVC_VIRT_V2V_INSPECTOR_BIN=virt-v2v-inspector
WVC_VIRT_V2V_OPEN_BIN=virt-v2v-open
WVC_VIRT_WIN_REG_BIN=virt-win-reg
WVC_VIRT_WHAT_BIN=virt-what
WVC_VIRT_TOP_BIN=virt-top

# VNC has no transport encryption. Keep this false unless the VNC network is
# independently protected; qemu+ssh is the safe remote-console path.
WVC_ALLOW_INSECURE_VNC=false

# Allow noVNC to initialize when the browser page itself is served over plain
# HTTP. This is intended only for a trusted LAN or encrypted VPN because login
# credentials, sessions, VNC passwords, and console traffic are not encrypted.
WVC_ALLOW_INSECURE_CONSOLE=false

# Docker-only: rewrite VNC targets to this host name/IP. This can work for a
# host listener on 0.0.0.0, but not for one bound strictly to 127.0.0.1; use a
# firewalled private bind address or qemu+ssh in that case. Native deployments
# must leave this empty. Remote qemu+ssh consoles are never rewritten.
WVC_CONSOLE_LOOPBACK_ADDRESS=host.docker.internal

# Docker-only paths. Keep SSH keys in a dedicated directory, never mount the
# whole host ~/.ssh directory into the container.
WVC_SSH_DIR=./deploy/ssh
# Optional host disk-image directory; also add it to docker-compose volumes if
# the local QEMU utility commands must manage host images.
WVC_IMAGE_DIR=/var/lib/libvirt/images
# Native service path checked by wvc doctor. Docker deployments normally keep
# this at the in-container mount point.
WVC_LOCAL_IMAGE_DIR=/var/lib/libvirt/images
# Native installer option: set to 1 only after reviewing direct image access.
# It grants the wvc service user rwX through a POSIX ACL because qemu-img and
# libguestfs run directly and require filesystem access beyond libvirt RPC.
WVC_GRANT_IMAGE_ACCESS=0
# Default Compose temporary storage is the named volume wvc-tmp. To use a
# host directory instead, follow the bind-mount instructions in README.md.
WVC_TMP_DIR=./data/tmp

# Container resource limits. libguestfs and virt-v2v can use several GB while
# converting disks; increase memory before running large conversion jobs.
WVC_APP_MEM_LIMIT=4g
WVC_APP_CPUS=2.0

# In-container health probe. Change only when WVC_ADDR is not :8080.
WVC_HEALTHCHECK_URL=http://127.0.0.1:8080/readyz

# Docker-only: group id owning /var/run/libvirt/libvirt-sock on the host.
LIBVIRT_GID=992

# Go module proxy used only while building the container image. Set this to
# https://goproxy.cn,direct when proxy.golang.org is not reachable.
GOPROXY=https://proxy.golang.org,direct

# Docker-only: optional Debian package mirrors for the runtime image.
# APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
# APT_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security

# Optional OpenLDAP/Active Directory login. LDAP users are provisioned locally
# as viewer accounts; an administrator assigns operator/desktop access after
# the first successful login. Directory passwords are never stored.
WVC_LDAP_ENABLED=false
WVC_LDAP_URL=ldaps://ldap.example.com:636
WVC_LDAP_BIND_DN=
WVC_LDAP_BIND_PASSWORD=
WVC_LDAP_BASE_DN=ou=people,dc=example,dc=com
WVC_LDAP_USER_FILTER=(uid=%s)
WVC_LDAP_STARTTLS=false
WVC_LDAP_INSECURE_TLS=false
WVC_LDAP_TIMEOUT=5s

# Optional operations webhook. The panel posts JSON events for VM power
# changes, disk/resource changes, host health checks, and backup actions.
# Use HTTPS in production. The token is sent as Authorization: Bearer.
WVC_WEBHOOK_URL=
WVC_WEBHOOK_TOKEN=
WVC_WEBHOOK_TIMEOUT=3s

[Unit]
Description=WebVirtCloud Go control plane
After=network-online.target libvirtd.service postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=wvc
Group=libvirt
WorkingDirectory=/var/lib/webvirtcloud-go
EnvironmentFile=/etc/webvirtcloud-go/env
Environment=TMPDIR=/var/lib/webvirtcloud-go/tmp
ExecStart=/usr/local/bin/wvc
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
LimitNOFILE=65536
LimitCORE=0
TasksMax=1024
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=~user
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
RemoveIPC=true
LockPersonality=true
UMask=0077
ReadWritePaths=/var/lib/webvirtcloud-go /var/tmp
ReadWritePaths=-/var/lib/libvirt/images

[Install]
WantedBy=multi-user.target
